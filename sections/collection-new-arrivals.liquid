{% comment %}
  Section: Curated New Arrivals (Editorial Drop Page)
  3-part minimal layout: Hero -> Grid -> Soft CTA
{% endcomment %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}

<div class="na-drop-page">
  
  <!-- 1. EDITORIAL HERO -->
  <div class="na-hero">
    {%- if section.settings.hero_video != blank -%}
      {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'na-hero__media' }}
    {%- elsif section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" width="{{ section.settings.hero_image.width | default: 2000 }}" height="{{ section.settings.hero_image.height | default: 1000 }}" class="na-hero__media" alt="{{ section.settings.title | escape }}">
    {%- else -%}
      <div class="na-hero__media na-hero__placeholder"></div>
    {%- endif -%}
    
    <div class="na-hero__overlay"></div>
    
    <div class="na-hero__content container text-center">
      <h1 class="na-hero__title">{{ section.settings.title | default: 'New Arrivals' }}</h1>
      <p class="na-hero__desc">{{ section.settings.description | default: 'Fresh formulations and recent additions crafted for everyday care.' }}</p>
      <a href="#na-grid" class="btn btn--primary na-hero__btn">{{ section.settings.hero_btn_label | default: 'Explore Latest' }}</a>
    </div>
  </div>

  <!-- 2. PRODUCT GRID -->
  <div class="na-grid-section" id="na-grid">
    <div class="container">
      {%- liquid
        assign key_list = 'kojic,beetroot,essential' | split: ','
        assign store_products = collection.products
        if collection == blank or collection.products_count == 0
          assign store_products = collections['all'].products
        endif
      -%}
      <div class="na-grid">
        {%- for key_raw in key_list -%}
          {%- assign key = key_raw | strip | downcase -%}
          {%- assign matched_product = nil -%}
          {%- for prod in store_products -%}
            {%- assign p_title = prod.title | downcase -%}
            {%- assign p_handle = prod.handle | downcase -%}
            {%- if p_title contains key or p_handle contains key -%}
              {%- assign matched_product = prod -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if matched_product != nil -%}
            <div class="na-grid__item">
              {% render 'product-card', product: matched_product, force_badge: 'NEW' %}
            </div>
          {%- else -%}
            <div class="na-grid__item">
              {%- case forloop.index -%}
                {%- when 1 -%}
                  <div class="pc">
                    <a href="/collections/all" class="pc__media">
                      <span class="pc__badge">NEW</span>
                      <div class="pc__img-placeholder" style="background: linear-gradient(135deg, #fdfbf7 0%, #f4eae1 100%); display:flex; align-items:center; justify-content:center; color:#5a2e2e; font-weight:600; font-family:'Cormorant Garamond',serif; font-size:1.2rem; text-align:center; padding:15px;">Kojic Glow Bar</div>
                    </a>
                    <div class="pc__info">
                      <a href="/collections/all" class="pc__name">Kojic Glow Bar</a>
                      <p class="pc__context">Brightening • Evening Tone • Daily Glow</p>
                      <div class="pc__pricing"><span class="pc__price">₹249</span></div>
                      <form method="post" action="{{ routes.cart_add_url }}" class="pc__form">
                        <button type="button" class="pc__atc">Add to Bag</button>
                      </form>
                    </div>
                  </div>
                {%- when 2 -%}
                  <div class="pc">
                    <a href="/collections/all" class="pc__media">
                      <span class="pc__badge">NEW</span>
                      <div class="pc__img-placeholder" style="background: linear-gradient(135deg, #fdfbf7 0%, #f5e4e6 100%); display:flex; align-items:center; justify-content:center; color:#5a2e2e; font-weight:600; font-family:'Cormorant Garamond',serif; font-size:1.2rem; text-align:center; padding:15px;">Beetroot Lip Balm</div>
                    </a>
                    <div class="pc__info">
                      <a href="/collections/all" class="pc__name">Beetroot Lip Balm</a>
                      <p class="pc__context">Hydrating • Natural Tint • Organic Beeswax</p>
                      <div class="pc__pricing"><span class="pc__price">₹149</span></div>
                      <form method="post" action="{{ routes.cart_add_url }}" class="pc__form">
                        <button type="button" class="pc__atc">Add to Bag</button>
                      </form>
                    </div>
                  </div>
                {%- when 3 -%}
                  <div class="pc">
                    <a href="/collections/all" class="pc__media">
                      <span class="pc__badge">NEW</span>
                      <div class="pc__img-placeholder" style="background: linear-gradient(135deg, #fdfbf7 0%, #eae5df 100%); display:flex; align-items:center; justify-content:center; color:#5a2e2e; font-weight:600; font-family:'Cormorant Garamond',serif; font-size:1.2rem; text-align:center; padding:15px;">Glow Essential Set</div>
                    </a>
                    <div class="pc__info">
                      <a href="/collections/all" class="pc__name">Glow Essential Set</a>
                      <p class="pc__context">Complete Ritual • Cleanse & Protect Pair</p>
                      <div class="pc__pricing"><span class="pc__price">₹599</span><span class="pc__mrp">₹699</span></div>
                      <form method="post" action="{{ routes.cart_add_url }}" class="pc__form">
                        <button type="button" class="pc__atc">Add to Bag</button>
                      </form>
                    </div>
                  </div>
              {%- endcase -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <!-- 3. SOFT CTA -->
  <div class="na-cta">
    <div class="container text-center">
      <h2 class="na-cta__title">{{ section.settings.cta_title | default: 'Not sure where to begin?' }}</h2>
      <p class="na-cta__desc">{{ section.settings.cta_desc | default: 'Explore the products our customers reach for the most.' }}</p>
      <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--primary na-cta__btn">
        {{ section.settings.cta_label | default: 'Shop Bestsellers' }}
      </a>
    </div>
  </div>

</div>

<style>
  .na-drop-page {
    color: var(--mm-dark-espresso, #2E1F1A);
    /* Inherits background-color from theme body seamlessly */
  }

  /* 1. HERO */
  .na-hero {
    position: relative;
    height: 60vh;
    min-height: 400px;
    max-height: 650px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 80px;
  }
  .na-hero__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .na-hero__placeholder {
    background-color: var(--mm-dark-espresso, #2E1F1A);
  }
  .na-hero__overlay {
    position: absolute;
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%;
    background: rgba(46, 31, 26, 0.4); /* Dark overlay to make text pop */
    z-index: 1;
  }
  .na-hero__content {
    position: relative;
    z-index: 2;
    color: #fff;
    max-width: 800px;
  }
  .na-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: var(--space-4);
    color: #fff; /* Override any theme defaults */
  }
  .na-hero__desc {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-family: var(--font-body);
    font-weight: 300;
    margin: 0 auto var(--space-8);
    letter-spacing: 0.02em;
    opacity: 0.9;
  }
  .na-hero__btn {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    padding: 14px 36px;
    border-radius: var(--radius-sm, 4px);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }
  .na-hero__btn:hover {
    background: #fff;
    color: var(--mm-dark-espresso, #2E1F1A);
  }

  /* 2. GRID */
  .na-grid-section {
    padding-bottom: 80px;
  }
  .na-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
  }
  
  /* 3. SOFT CTA */
  .na-cta {
    padding: 80px 0 100px;
    border-top: 1px solid rgba(46,31,26,0.05); /* very soft divider */
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 250px;
  }
  .na-cta__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 500;
    color: var(--mm-deep-garnet, #4B2A31);
    margin-bottom: var(--space-4);
  }
  .na-cta__desc {
    font-size: 1.05rem;
    color: var(--mm-dark-espresso, #2E1F1A);
    opacity: 0.8;
    margin-bottom: var(--space-8);
  }
  .na-cta__btn {
    padding: 14px 40px;
    background-color: var(--mm-dark-espresso, #2E1F1A);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm, 4px);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    transition: background 0.3s ease, transform 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }
  .na-cta__btn:hover {
    background-color: var(--mm-deep-garnet, #4B2A31);
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .na-grid {
      grid-template-columns: 1fr; /* 1 per row on mobile */
      gap: var(--space-10);
    }
    .na-hero {
      height: 50vh;
      min-height: 350px;
      margin-bottom: 40px;
    }
    .na-cta {
      padding: 60px 0 80px;
    }
  }
</style>

{% schema %}
{
  "name": "New Arrivals Layout",
  "settings": [
    {
      "type": "header",
      "content": "1. Editorial Hero"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Fresh formulations and recent additions crafted for everyday care."
    },
    {
      "type": "text",
      "id": "hero_btn_label",
      "label": "Button Label",
      "default": "Explore Latest"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image",
      "info": "Used if no video is selected."
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero Video",
      "info": "Overrides image. Auto-plays subtly in background."
    },
    {
      "type": "header",
      "content": "3. Final Soft CTA"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Heading",
      "default": "Not sure where to begin?"
    },
    {
      "type": "text",
      "id": "cta_desc",
      "label": "Description",
      "default": "Explore the products our customers reach for the most."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link",
      "info": "We recommend linking to /collections/best-sellers"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals Layout"
    }
  ]
}
{% endschema %}
